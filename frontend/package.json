{
  "name": "swipeit-frontend",
  "version": "0.1.0",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "catalog:sync": "node scripts/catalog-sync.mjs",
    "predev": "npm run catalog:sync",
    "dev": "next dev",
    "prebuild": "npm run catalog:sync",
    "build": "next build",
    "lan": "npm run build && tsx --tsconfig lan/tsconfig.json lan/server.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p lan/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "steiger": "steiger ./src",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run steiger && npm run format:check && npm run test"
  },
  "dependencies": {
    "@swipeit/core": "*",
    "@tanstack/react-query": "^5.99.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^0.560.0",
    "lz-string": "^1.5.0",
    "motion": "^12.23.0",
    "nanoid": "^5.1.6",
    "next": "^16.2.3",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.1.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "^0.6.0",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "^5.99.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.5",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.2.1",
    "eslint-plugin-perfectionist": "^5.10.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.6.2",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.35.5",
    "sirv": "^3.0.2",
    "steiger": "^0.5.13",
    "tailwindcss": "^4",
    "tsx": "^4.20.0",
    "typescript": "^5",
    "vitest": "^3.2.4",
    "ws": "^8.18.3"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  },
  "browserslist": {
    "production": [
      "chrome >= 109",
      "edge >= 109",
      "firefox >= 115",
      "safari >= 15.4",
      "ios_saf >= 15.4"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
