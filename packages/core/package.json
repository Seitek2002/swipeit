{
  "name": "@swipeit/core",
  "version": "0.1.0",
  "private": true,
  "description": "Общий контракт API и чистая логика SwipeIt: схемы, типы, ошибки, лента, вкус, даты, кодек ссылок (BACKEND.md §2.2, B02).",
  "type": "module",
  "exports": {
    "./config": "./src/config/index.ts",
    "./format": "./src/format/index.ts",
    "./share-codec": "./src/share-codec/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "lz-string": "^1.5.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "prettier": "^3.6.2",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{ts,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
