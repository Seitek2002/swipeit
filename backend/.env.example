# Переменные сервера (BACKEND.md §10). Скопируй в .env и заполни. Значения
# секретов в репозиторий не кладём.

# development | production | test
NODE_ENV=development
# Где слушать
HOST=0.0.0.0
PORT=4100
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Коммит сборки — показывается в /v1/health (в CI подставляется сам)
COMMIT=dev
