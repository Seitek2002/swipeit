# Переменные сервера (BACKEND.md §10). Скопируй в .env и заполни. Значения
# секретов в репозиторий не кладём.

# development | production | test
NODE_ENV=development
# Где слушать
HOST=0.0.0.0
PORT=4100
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Коммит сборки — показывается в /v1/health (в CI подставляется сам)
COMMIT=dev
# PostgreSQL. Не задана — база из backend/docker-compose.yml (ниже).
# В production обязательна.
# DATABASE_URL=postgres://swipeit:swipeit@127.0.0.1:5433/swipeit
# Размер пула соединений
DATABASE_POOL_MAX=10
# Начало коротких ссылок: url = PUBLIC_SHARE_URL/s/<код> (§6.2). Пока домена
# нет — адрес API. Не задан — http://localhost:PORT. В production обязателен.
# PUBLIC_SHARE_URL=https://swipeit.example
