# Настройки SwipeIt на сервере (backend/deploy/.env). Инструкция — ADMIN.md.
#
#   cp .env.example .env   — и заполните.
#
# Здесь только образцы: настоящие пароли и ключи — только в .env на сервере,
# в репозиторий .env не попадает. Пустое значение («OPS_TOKEN=») значит «не
# задано». Пароли и ключи — из латиницы и цифр, например: openssl rand -hex 24
# После правки .env: docker compose up -d

# ─── Версия ──────────────────────────────────────────────────────────────────
# Тег образов ghcr.io/seitek2002/swipeit-api и swipeit-web: staging — последний
# зелёный main; для отката — тег прошлого коммита (короткий хеш, 7 символов).
API_TAG=staging
WEB_TAG=staging

# ─── Адрес ───────────────────────────────────────────────────────────────────
# Адрес продукта — тот, что люди открывают в браузере (с https://, без «/» в
# конце). Фронт и API на одном адресе (контейнер web), поэтому оба адреса
# одинаковые: на PUBLIC_SHARE_URL строятся короткие ссылки /s/<код>, а
# PUBLIC_APP_URL — куда превью ссылки переводит человека.
PUBLIC_APP_URL=https://swipeit.example.kg
PUBLIC_SHARE_URL=https://swipeit.example.kg

# Адреса фронта на ДРУГОМ домене, которым можно ходить в API (CORS), через
# запятую. При одном адресе — пусто.
CORS_ORIGINS=

# Кому верить в заголовке X-Forwarded-For (настоящий IP человека для лимитов
# запросов). loopback,uniquelocal — внутренние адреса: web и прокси на этом
# сервере. Прокси на другой машине с внешним адресом — допишите его через
# запятую, например loopback,uniquelocal,203.0.113.10
TRUST_PROXY=loopback,uniquelocal

# Где слушает контейнер web (HTTP). Свой nginx на этом сервере — оставьте
# 127.0.0.1 и проксируйте на 127.0.0.1:8080.
WEB_BIND=127.0.0.1
WEB_PORT=8080

# Только для профиля caddy (HTTPS без своего прокси): домен без https://,
# например swipeit.example.kg. DNS домена должен смотреть на этот сервер.
SITE_ADDRESS=

# ─── База ────────────────────────────────────────────────────────────────────
# Postgres в контейнере postgres. Пароль — обязательно, только латиница и
# цифры (он попадает в адрес базы). DATABASE_URL задавать не нужно:
# docker-compose.yml собирает его сам — postgres://POSTGRES_USER:POSTGRES_PASSWORD@postgres:5432/POSTGRES_DB
POSTGRES_USER=swipeit
POSTGRES_DB=swipeit
POSTGRES_PASSWORD=
# Размер пула соединений сервера к базе (по умолчанию 10).
# DATABASE_POOL_MAX=10

# ─── Отчёт для владельца ─────────────────────────────────────────────────────
# Токен для GET /v1/ops/report (не короче 24 символов): openssl rand -hex 24
# Пусто — адреса как будто нет (404).
OPS_TOKEN=

# ─── Несколько вишлистов ─────────────────────────────────────────────────────
# «1» — у людей может быть несколько вишлистов. Пусто — выключено (в production),
# всё как с одним «Общим». Включать вместе со сборкой web с MULTI_WISHLISTS=1
# (ADMIN.md §15). Не включайте до конца офисного пилота Санты без владельца.
FEATURE_MULTI_WISHLISTS=

# ─── Вход через Telegram ─────────────────────────────────────────────────────
# Client ID бота из @BotFather → Login Widget (число, не секрет). Пусто — входа
# через Telegram нет: кнопок не видно, POST /v1/auth/telegram отвечает 404.
# То же число — в переменной репозитория GitHub TELEGRAM_CLIENT_ID для сборки
# web (ADMIN.md §13). Client Secret не нужен — никуда его не вписывайте.
TELEGRAM_CLIENT_ID=
# Открытые ключи Telegram для проверки входа. Менять не нужно.
# TELEGRAM_JWKS_URL=https://oauth.telegram.org/.well-known/jwks.json
# Токен того же бота из @BotFather (/mybots → бот → API Token) — СЕКРЕТ, только
# здесь. Бот пишет уведомления тем, кто вошёл через Telegram: «жеребьёвка
# прошла», «новое письмо», «до обмена 3 дня» (ADMIN.md §14). Пусто — бот никому
# не пишет, сообщения видны только в логе api.
TELEGRAM_BOT_TOKEN=
# Адрес Bot API. Менять не нужно.
# TELEGRAM_API_URL=https://api.telegram.org

# ─── Обновление приложения ───────────────────────────────────────────────────
# Самая старая сборка фронта, с которой сервер ещё работает. Сборки старее
# увидят «Вышла новая версия». Номер сборки = номер прогона GitHub Actions
# (Actions → прогон «#123»). 0 — пускать всех.
MIN_CLIENT_BUILD=0

# ─── Лимиты запросов ─────────────────────────────────────────────────────────
# Значения по умолчанию; поднять можно без нового образа. Раскомментируйте
# нужное, если в логах много ответов 429.
# В минуту на сессию и с одного IP — все запросы:
# RATE_ALL_SESSION=300
# RATE_ALL_IP=600
# Новые профили с одного IP — в минуту и в час:
# RATE_USERS_MINUTE=20
# RATE_USERS_HOUR=200
# Открытия ссылок — в минуту на сессию и с IP:
# RATE_SHARE_SESSION=60
# RATE_SHARE_IP=300
# Брони — в минуту на человека:
# RATE_RESERVATIONS=30
# Шаги воронки от клиента — в минуту на сессию:
# RATE_FUNNEL=30
# Вход через Telegram — с одного IP, в минуту и в час:
# RATE_TELEGRAM_MINUTE=20
# RATE_TELEGRAM_HOUR=200

# ─── Прочее ──────────────────────────────────────────────────────────────────
# Подробность логов: fatal, error, warn, info, debug, trace.
LOG_LEVEL=info
# Не задавайте — уже заданы в образе или в docker-compose.yml:
#   COMMIT      — коммит сборки, его показывает /v1/health (вшит в образ);
#   UPLOADS_DIR — папка фото /data/uploads (том uploads);
#   NODE_ENV, HOST, PORT, TZ, CATALOG_DIR.

# ─── Бэкапы ──────────────────────────────────────────────────────────────────
# Раз в сутки в этот час (по Бишкеку) — база и фото в том backups.
BACKUP_HOUR=3
# Сколько хранить на сервере: ежедневных и еженедельных копий.
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8

# Копия в хранилище ДРУГОГО провайдера (S3-совместимое: AWS S3, Cloudflare R2,
# Backblaze B2 и т. п.). Выгружается только зашифрованной: нужны и ключ, и
# хранилище. Без них копии только на этом сервере — в логе backup будет
# предупреждение.
# Ключ шифрования: openssl rand -hex 32. Храните его ещё и вне сервера —
# без ключа зашифрованную копию не открыть.
BACKUP_ENCRYPT_KEY=
BACKUP_S3_BUCKET=
# Папка внутри хранилища.
BACKUP_S3_PREFIX=swipeit
# Адрес хранилища, если это не AWS (например https://<id>.r2.cloudflarestorage.com).
BACKUP_S3_ENDPOINT=
# Регион (для R2 — auto; пусто — us-east-1).
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
