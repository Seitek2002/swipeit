{
  "name": "@swipeit/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node24 --format=esm --packages=external --sourcemap --outfile=dist/server.js",
    "start": "node --enable-source-maps --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "fastify": "^5.6.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^24",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "prettier": "^3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{ts,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
