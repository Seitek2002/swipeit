{
  "name": "@swipeit/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "node build.mjs",
    "start": "node --enable-source-maps --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate-cli.ts",
    "db:seed:dev": "tsx --env-file-if-exists=.env src/db/seed-dev.ts",
    "funnel": "tsx --env-file-if-exists=.env src/db/funnel-cli.ts",
    "funnel:team": "tsx --env-file-if-exists=.env src/db/funnel-team-cli.ts"
  },
  "dependencies": {
    "@swipeit/core": "*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.6.0",
    "nanoid": "^5.1.6",
    "pg": "^8.23.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "globals": "^16",
    "prettier": "^3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{ts,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
