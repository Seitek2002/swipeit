{
  "name": "swipeit",
  "private": true,
  "description": "SwipeIt: фронт (демо и продукт), общий пакет core и сервер. Рабочее пространство npm (BACKEND.md §2.3).",
  "workspaces": [
    "packages/*",
    "frontend",
    "backend"
  ],
  "scripts": {
    "check": "npm run check --workspaces --if-present",
    "build": "npm run build -w frontend",
    "prepare": "husky frontend/.husky"
  },
  "devDependencies": {
    "drizzle-orm": "^0.45.4",
    "husky": "^9.1.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true
  }
}
